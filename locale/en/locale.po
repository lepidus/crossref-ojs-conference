msgid "plugins.importexport.crossrefConference.displayName"
msgstr "Crossref Conference XML Export Plugin"

msgid "plugins.importexport.crossrefConference.description"
msgstr "Export conference metadata in Crossref Conference XML format."

msgid "plugins.importexport.crossrefConference.error.publisherNotConfigured"
msgstr "A journal publisher has not been configured! You must add a publisher institution on the <a href=\"{$journalSettingsUrl}\" target=\"_blank\">Journal Settings Page</a>."

msgid "plugins.importexport.crossrefConference.error.issnNotConfigured"
msgstr "A journal ISSN has not been configured! You must add an ISSN on the <a href=\"{$journalSettingsUrl}\" target=\"_blank\">Journal Settings Page</a>."

msgid "plugins.importexport.crossrefConference.settings.depositorIntro"
msgstr "The following items are required for a successful crossrefConference deposit."

msgid "plugins.importexport.crossrefConference.settings.form.depositorName"
msgstr "Depositor name"

msgid "plugins.importexport.crossrefConference.settings.form.depositorEmail"
msgstr "Depositor email"

msgid "plugins.importexport.crossrefConference.registrationIntro"
msgstr "If you would like to use this plugin to register Digital Object Identifiers (DOIs) directly with crossrefConference you will need a username and password (available from <a href=\"http://www.crossref.org\" target=\"_blank\">crossref</a>) in order to do so. If you do not have your own username and password you can still export into the crossrefConference XML format, but you cannot register your DOIs with crossrefConference from within OJS."

msgid "plugins.importexport.crossrefConference.settings.form.username"
msgstr "Username"

msgid "plugins.importexport.crossrefConference.settings.conferenceName"
msgstr "Enter the conference name"

msgid "plugins.importexport.crossrefConference.settings.form.conferenceName"
msgstr "Conference name"

msgid "plugins.importexport.crossrefConference.settings.form.conferenceNameRequired"
msgstr "Please enter the conference name."

msgid "plugins.importexport.crossrefConference.settings.form.testMode.description"
msgstr "Use the crossrefConference test API (testing environment) for the DOI deposit. Please do not forget to remove this option for the production."

msgid "plugins.importexport.crossrefConference.register.error.mdsError"
msgstr "Registration was not fully successful! The DOI registration server returned an error."

msgid "plugins.importexport.crossrefConference.register.success.warning"
msgstr "Registration was successful but the following warning occurred: '{$param}'."

msgid "plugins.importexport.crossrefConference.settings.form.conferenceNameOptionIssueTitle"
msgstr "Use issue title"

msgid "plugins.importexport.crossrefConference.settings.form.conferenceNameOptionCustom"
msgstr "Enter conference name"

msgid "plugins.importexport.crossrefConference.registrationAgency.name"
msgstr "Crossref (Conference)"

msgid "plugins.importexport.crossrefConference.issues.notSupported"
msgstr "Crossref Conference registers the DOIs of conference papers only. Issue DOIs are not deposited."
