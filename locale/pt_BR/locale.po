msgid "plugins.importexport.crossrefConference.displayName"
msgstr "Exportação CrossRef em XML para o formato conferência"

msgid "plugins.importexport.crossrefConference.description"
msgstr "Exporta metadados da conferência no formato CrossRef XML."

msgid "plugins.importexport.crossrefConference.error.publisherNotConfigured"
msgstr "A instituição editora da revista não foi configurado! Você deve adicionar uma instituição editora na <a href=\"{$journalSettingsUrl}\" target=\"_blank\"> Página de Configurações da Revista</a>."

msgid "plugins.importexport.crossrefConference.error.issnNotConfigured"
msgstr "O ISSN da revista não foi configurado! Você deve adicionar um ISSN na <a href=\"{$journalSettingsUrl}\" target=\"_blank\"> Página de Configurações do Revista</a>."

msgid "plugins.importexport.crossrefConference.settings.depositorIntro"
msgstr "Os seguintes items são exigidos para um depósito bem sucedido na Crossref."

msgid "plugins.importexport.crossrefConference.settings.form.depositorName"
msgstr "Nome do depositante"

msgid "plugins.importexport.crossrefConference.settings.form.depositorEmail"
msgstr "Email do depositante"

msgid "plugins.importexport.crossrefConference.registrationIntro"
msgstr "Se você quiser usar este plugin para registrar Digital Object Identifiers (DOIs) diretamente com o CrossRef, você precisará de um nome de usuário e senha (disponível em <a href=\"http://www.crossref.org\" target=\"_blank\"> CrossRef </a>). Se você não tiver seu próprio nome de usuário e senha, ainda poderá exportar para o formato CrossRef XML, mas não poderá registrar os nomes DOI com a CrossRef a partir do OJS."

msgid "plugins.importexport.crossrefConference.settings.form.username"
msgstr "Nome de usuário"

msgid "plugins.importexport.crossrefConference.settings.conferenceName"
msgstr "Digite o nome da conferência"

msgid "plugins.importexport.crossrefConference.settings.form.conferenceName"
msgstr "Nome da conferência"

msgid "plugins.importexport.crossrefConference.settings.form.conferenceNameRequired"
msgstr "Por favor digite o nome da conferência"

msgid "plugins.importexport.crossrefConference.settings.form.testMode.description"
msgstr "Use a API de teste CrossRef (ambiente de teste) para o depósito DOI. Não se esqueça de remover esta opção para a produção."

msgid "plugins.importexport.crossrefConference.register.success.warning"
msgstr "O registro foi bem-sucedido, mas ocorreu o seguinte aviso: '{$param}'."

msgid "plugins.importexport.crossrefConference.register.error.mdsError"
msgstr ""
"O registro não foi totalmente bem-sucedido! O servidor de registro DOI "
"retornou um erro."

msgid "plugins.importexport.crossrefConference.settings.form.conferenceNameOptionIssueTitle"
msgstr "Usar título da edição"

msgid "plugins.importexport.crossrefConference.settings.form.conferenceNameOptionCustom"
msgstr "Inserir nome da conferência"

msgid "plugins.importexport.crossrefConference.registrationAgency.name"
msgstr "Crossref (Conferência)"

msgid "plugins.importexport.crossrefConference.issues.notSupported"
msgstr "O Crossref Conferência registra apenas os DOIs de trabalhos de conferência. DOIs de edições não são depositados."
